local Watching = {}
local Notified = {}

local function Store(tool)
	local EatRemote = tool:FindFirstChild("EatRemote", true)
	if not EatRemote then
		return
	end

	ReplicatedStorage.Remotes.CommF_:InvokeServer(
		"StoreFruit",
		EatRemote.Parent:GetAttribute("OriginalName"),
		tool
	)

	if not Watching[tool] then
		Watching[tool] = true

		task.spawn(function()
			local fruitName = tool.Name

			while tool.Parent do
				task.wait(0.1)
			end

			if not Notified[tool] then
				Notified[tool] = true
				SendWebhook("âœ… Stored Successfully", fruitName)
			end

			Watching[tool] = nil
		end)
	end
end

