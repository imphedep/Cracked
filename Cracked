local ReportedFruits = {}

local function FindFruit()
	for _, fruit in ipairs(workspace:GetChildren()) do
		if (fruit:IsA("Tool") or fruit:IsA("Model"))
			and fruit.Name:find("Fruit") then

			local handle = fruit:FindFirstChild("Handle")

			if handle and handle:IsA("BasePart") then

				if not ReportedFruits[fruit] then
					ReportedFruits[fruit] = true

					SendWebhook("đŸ Fruit found", fruit.Name)

					fruit.Destroying:Connect(function()
						ReportedFruits[fruit] = nil
					end)
				end

				return fruit
			end
		end
	end
end

function Hop()
    local success, data = pcall(function()
        return HttpService:JSONDecode(
            game:HttpGet(
                "https://games.roblox.com/v1/games/"
                .. game.PlaceId ..
                "/servers/Public?sortOrder=Asc&limit=100"
            )
        )
    end)

    if not success or not data or not data.data then
        warn("Failed to get servers")
        return
    end

    local servers = {}

    for _, s in ipairs(data.data) do
        if s.id ~= game.JobId
        and s.playing > 0
        and s.playing < s.maxPlayers then
            table.insert(servers, s)
        end
    end

    if #servers == 0 then
        warn("No servers found")
        return
    end

    while #servers > 0 do
        local index = math.random(1, #servers)
        local server = servers[index]

        local ok = pcall(function()
            game:GetService("ReplicatedStorage").__ServerBrowser:InvokeServer("teleport", server.id)
        end)

        if ok then
            return
        end

        table.remove(servers, index)
        task.wait(0.2)
    end

    warn("All teleports failed")
end

