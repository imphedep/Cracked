local function getLink4mUrl()
    local currentKey = generateNewKey()
    local fullTargetUrl = TARGET_URL_1 .. "?ma=" .. currentKey
    local api_url = "https://link4m.co/api-shorten/v2?api=" .. TOKEN_LINK4M .. "&url=" .. HttpService:UrlEncode(fullTargetUrl)
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(api_url))
    end)
    if success and result and result.status ~= "error" then
        return result.shortenedUrl
    else
        return fullTargetUrl
    end
end

local function getBbmktsUrl()
    local currentKey = generateNewKey()
    local fullTargetUrl = TARGET_URL_2 .. "?ma=" .. currentKey
    local api_url = "https://bbmkts.com/dapi?token=" .. TOKEN_BBMKTS .. "&longurl=" .. HttpService:UrlEncode(fullTargetUrl) .. "&format=text"
    local success, result = pcall(function() return game:HttpGet(api_url) end)
    if success and result and result ~= "" then
        return string.gsub(result, "^%s*(.-)%s*$", "%1")
    else
        return fullTargetUrl
    end
end

